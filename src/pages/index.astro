---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import DeckWrapper from '@/components/sections/DeckWrapper.astro';
import CTA from '@/components/sections/CTA.astro';
import { faqHome } from '@/content/home';
import { organization, website, service, faqPage } from '@/lib/seo';

const title = 'MAYIA Monitoreo de Medios | MAYIA Escucha (Monitor IA)';
const description = 'MAYIA Escucha es el sistema de monitoreo de medios con IA de MAYIA: escucha radio en vivo, transcribe con Whisper y guarda un testigo por cada mención. Incluye SOC, nube y desarrollo con IA.';
---
<Base title={title} description={description} path="/" jsonLd={[organization(), website(), service(), faqPage(faqHome)]}>
  <Hero />
  <DeckWrapper />
  <CTA />
</Base>
