---
import fs from 'node:fs';
import path from 'node:path';
import '@/styles/global.css';
import { site, absoluteUrl } from '@/config/site';
import { images } from '@/config/assets';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import ScrollProgress from '@/components/motion/ScrollProgress.astro';

interface Props { title: string; description: string; path: string; jsonLd?: object[]; noindex?: boolean }
const { title, description, path: pagePath, jsonLd = [], noindex = false } = Astro.props;

const canonical = absoluteUrl(pagePath);
const ogFile = images.og.src;
const ogImage = fs.existsSync(path.join(process.cwd(), 'public', ogFile)) ? `${site.url}${ogFile}` : undefined;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-MX" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#05050a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
    <noscript><style>[data-reveal],[data-split] .w>span{opacity:1!important;transform:none!important}</style></noscript>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">Saltar al contenido</a>
    <ScrollProgress />
    <Header currentPath={pagePath} />
    <main id="main"><slot /></main>
    <Footer />
    <script>import '@/scripts/motion';</script>
  </body>
</html>
