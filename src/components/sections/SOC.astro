---
import { soc } from '@/content/home';
import { images } from '@/config/assets';
import Img from '@/components/ui/Img.astro';
import Parallax from '@/components/motion/Parallax.astro';
import Reveal from '@/components/motion/Reveal.astro';
import TextSplit from '@/components/motion/TextSplit.astro';
---
<section id="soc" aria-labelledby="soc-title" class="relative isolate overflow-hidden">
  <Parallax speed={0.18} class="absolute inset-0 -z-10">
    <Img src={images.soc.src} alt={images.soc.alt} width={images.soc.width} height={images.soc.height} class="h-full w-full object-cover" />
  </Parallax>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg via-bg/75 to-bg/30" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true" style="background: radial-gradient(80% 60% at 75% 50%, rgba(34, 197, 94, 0.14), transparent 70%);"></div>
  <div class="container-x flex min-h-[80vh] flex-col justify-end py-24">
    <Reveal><p class="eyebrow mb-4">{soc.eyebrow}</p></Reveal>
    <TextSplit id="soc-title" as="h2" class="max-w-3xl text-4xl font-semibold md:text-7xl tracking-tight" text={soc.title} />
    <Reveal delay={0.1}><p class="mt-6 max-w-xl text-lg text-fg/80 leading-relaxed">{soc.body}</p></Reveal>
    <Reveal class="mt-12 grid max-w-3xl gap-3.5 sm:grid-cols-3" stagger>
      {soc.overlay.map((o) => (
        <div class="rounded-xl border border-line-strong/60 bg-surface/80 p-4 font-mono backdrop-blur-xl shadow-md transition-all duration-300 hover:border-accent/60 hover:shadow-[0_0_20px_rgba(34,197,94,0.2)]">
          <p class="text-[0.68rem] uppercase tracking-wider text-subtle">{o.label}</p>
          <p class="mt-1.5 text-xl font-bold text-accent-bright">{o.value}</p>
        </div>
      ))}
    </Reveal>
  </div>
</section>
