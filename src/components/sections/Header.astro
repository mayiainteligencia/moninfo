---
import { site, routes } from '@/config/site';
import { logos } from '@/config/assets';
import Icon from '@/components/ui/Icon.astro';
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const links = Object.values(routes);
const active = (p: string) => (p === '/' ? currentPath === '/' : currentPath.startsWith(p));
---
<header class="fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-bg/85 backdrop-blur-2xl">
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 group" aria-label={site.name}>
      <img src={logos.escucha.src} alt={logos.escucha.alt} width="190" height="36" class="h-8 sm:h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02]" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1.5 rounded-full border border-line bg-surface/70 px-3 py-1.5 backdrop-blur-lg md:flex shadow-inner">
      {links.map((l) => (
        <a href={l.path} aria-current={active(l.path) ? 'page' : undefined}
           class={`rounded-full px-4 py-1.5 text-sm transition-all duration-300 hover:text-fg ${active(l.path) ? 'bg-surface-3 text-accent font-medium shadow-[0_0_15px_rgba(219,242,133,0.2)]' : 'text-muted hover:bg-surface-2/60'}`}>{l.label}</a>
      ))}
      <a href={site.parents.mayia.url} target="_blank" rel="noopener" class="ml-1 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs text-muted transition-colors hover:text-accent">
        mayia.mx <Icon name="external" size={13} />
      </a>
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a href="#contacto" class="group flex items-center gap-2.5 rounded-full border border-line-strong bg-surface-2/80 px-4 py-1.5 text-xs font-medium text-fg shadow-sm backdrop-blur transition-all duration-300 hover:border-accent hover:shadow-[0_0_20px_rgba(219,242,133,0.35)]">
        <span>Contacto</span>
        <span class="flex size-5 items-center justify-center rounded-full bg-accent text-bg transition-transform duration-300 group-hover:scale-110">
          <svg class="size-2.5 fill-current" viewBox="0 0 12 12"><path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </div>
    <details class="group relative md:hidden">
      <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full hairline bg-surface-2" aria-label="Abrir menú">
        <Icon name="plus" size={18} class="transition-transform group-open:rotate-45 text-accent" />
      </summary>
      <nav aria-label="Principal móvil" class="absolute right-0 top-12 grid w-64 gap-1 rounded-lg hairline bg-surface p-2 shadow-card backdrop-blur-xl">
        {links.map((l) => <a href={l.path} class="rounded-md px-3 py-2.5 text-sm text-muted hover:bg-surface-3 hover:text-fg">{l.label}</a>)}
        <a href={site.parents.mayia.url} target="_blank" rel="noopener" class="rounded-md px-3 py-2.5 text-sm text-muted hover:bg-surface-3 hover:text-fg">mayia.mx</a>
        <a href={site.parents.flai.url} target="_blank" rel="noopener" class="rounded-md px-3 py-2.5 text-sm text-muted hover:bg-surface-3 hover:text-fg">flainube.mx</a>
        <a href="#contacto" class="mt-2 flex items-center justify-center gap-2 rounded-full bg-accent py-2 text-xs font-semibold text-bg">Contacto</a>
      </nav>
    </details>
  </div>
</header>

