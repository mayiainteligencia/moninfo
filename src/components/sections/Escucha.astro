---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Counter from '@/components/ui/Counter.astro';
import SignalWitnessInspector from '@/components/islands/SignalWitnessInspector';
---
<section id="escucha" class="relative isolate py-1 sm:py-2 w-full">
  <div class="container-x">
    <!-- Encabezado de Sección: Compacto y Pegado al contenido sin vacíos -->
    <div class="mb-3 max-w-3xl">
      <div class="flex items-center gap-2 mb-1.5">
        <div class="h-1 w-8 rounded-full bg-accent shadow-[0_0_10px_rgba(34,197,94,0.7)]"></div>
        <span class="font-mono text-[0.65rem] sm:text-xs uppercase tracking-widest text-accent font-semibold">// NODO DE MONITOREO LOCAL</span>
      </div>
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl md:text-4xl leading-[1.1]">
        Escucha local, <span class="text-accent">rápida y verificable.</span>
      </h2>
      <p class="mt-1.5 text-xs sm:text-sm text-muted/90 leading-relaxed max-w-2xl">
        MAYIA Escucha transcribe con Whisper en servidor propio, sin costo por minuto de transcripción, y conserva un testigo inmutable por cada coincidencia.
      </p>
    </div>

    <!-- 1. Grid de Telemetría: 4 Tarjetas estilo Card idénticas al resto del sitio -->
    <div class="grid gap-2.5 sm:gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-3">
      <!-- Métrica 1: Captura -->
      <div class="group relative overflow-hidden rounded-xl border border-line-strong/60 bg-surface-2/60 p-3 sm:p-3.5 shadow-card backdrop-blur-xl transition-all duration-300 hover:border-accent/60 hover:bg-surface-2/80">
        <div class="flex items-center justify-between font-mono text-[0.65rem] text-muted">
          <span class="flex items-center gap-1.5 text-accent font-semibold">
            <Icon name="audio-lines" size={13} />
            <span>VENTANA CAPTURA</span>
          </span>
          <span class="rounded bg-surface-3 px-1.5 py-0.2 text-accent-bright font-mono text-[0.62rem]">16 kHz MONO</span>
        </div>
        <div class="mt-2.5">
          <Counter to={5} suffix=" s" label="" />
        </div>
        <div class="mt-2 flex items-center gap-1.5">
          <div class="flex items-end gap-1 h-3 flex-1">
            <span class="w-1.5 h-1.5 rounded-full bg-accent/40 group-hover:bg-accent transition-colors"></span>
            <span class="w-1.5 h-3 rounded-full bg-accent/80 group-hover:bg-accent transition-colors"></span>
            <span class="w-1.5 h-2 rounded-full bg-accent/60 group-hover:bg-accent transition-colors"></span>
            <span class="w-1.5 h-3 rounded-full bg-accent group-hover:bg-accent transition-colors"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-accent/50 group-hover:bg-accent transition-colors"></span>
            <span class="w-1.5 h-2.5 rounded-full bg-accent/70 group-hover:bg-accent transition-colors"></span>
          </div>
          <span class="font-mono text-[0.6rem] text-subtle uppercase">Buffer Activo</span>
        </div>
        <p class="mt-1.5 text-[0.68rem] text-muted leading-tight">Segmento continuo de audio sin pérdida ni silencios.</p>
      </div>

      <!-- Métrica 2: Inferencia -->
      <div class="group relative overflow-hidden rounded-xl border border-line-strong/60 bg-surface-2/60 p-3 sm:p-3.5 shadow-card backdrop-blur-xl transition-all duration-300 hover:border-accent/60 hover:bg-surface-2/80">
        <div class="flex items-center justify-between font-mono text-[0.65rem] text-muted">
          <span class="flex items-center gap-1.5 text-accent font-semibold">
            <Icon name="cpu" size={13} />
            <span>INFERENCIA GPU</span>
          </span>
          <span class="rounded bg-surface-3 px-1.5 py-0.2 text-accent-bright font-mono text-[0.62rem]">WHISPER PROPIO</span>
        </div>
        <div class="mt-2.5">
          <Counter to={0.3} decimals={1} suffix=" s" label="" />
        </div>
        <div class="mt-2">
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-surface-3">
            <div class="h-full w-[16%] rounded-full bg-accent shadow-[0_0_8px_rgba(74,222,128,0.8)]"></div>
          </div>
          <div class="mt-1 flex justify-between font-mono text-[0.6rem] text-subtle">
            <span>0.3s PROCESO</span>
            <span class="text-accent">94% HOLGURA</span>
          </div>
        </div>
        <p class="mt-1.5 text-[0.68rem] text-muted leading-tight">En transcribir 5s con servidor local y cero costo por min.</p>
      </div>

      <!-- Métrica 3: RTF -->
      <div class="group relative overflow-hidden rounded-xl border border-line-strong/60 bg-surface-2/60 p-3 sm:p-3.5 shadow-card backdrop-blur-xl transition-all duration-300 hover:border-accent/60 hover:bg-surface-2/80">
        <div class="flex items-center justify-between font-mono text-[0.65rem] text-muted">
          <span class="flex items-center gap-1.5 text-accent font-semibold">
            <Icon name="gauge" size={13} />
            <span>FACTOR RTF</span>
          </span>
          <span class="rounded bg-accent/15 px-1.5 py-0.2 text-accent-bright font-mono text-[0.62rem] font-semibold">16.6x SPEED</span>
        </div>
        <div class="mt-2.5">
          <Counter to={0.06} decimals={2} prefix="≈ " label="" />
        </div>
        <div class="mt-2 flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
          <span class="font-mono text-[0.62rem] text-accent font-medium">TIEMPO REAL SIMULTÁNEO</span>
        </div>
        <p class="mt-1.5 text-[0.68rem] text-muted leading-tight">Capacidad para procesar múltiples emisoras a la vez.</p>
      </div>

      <!-- Métrica 4: Testigo Inmutable -->
      <div class="group relative overflow-hidden rounded-xl border border-line-strong/60 bg-surface-2/60 p-3 sm:p-3.5 shadow-card backdrop-blur-xl transition-all duration-300 hover:border-accent/60 hover:bg-surface-2/80">
        <div class="flex items-center justify-between font-mono text-[0.65rem] text-muted">
          <span class="flex items-center gap-1.5 text-accent font-semibold">
            <Icon name="file-check" size={13} />
            <span>AUDITORÍA</span>
          </span>
          <span class="rounded bg-surface-3 px-1.5 py-0.2 text-subtle font-mono text-[0.62rem]">INMUTABLE</span>
        </div>
        <div class="mt-2.5">
          <p class="font-mono text-2xl font-semibold tracking-tight text-white sm:text-3xl">100%</p>
        </div>
        <div class="mt-2 font-mono text-[0.6rem] text-accent truncate bg-surface-3/50 px-2 py-0.5 rounded border border-line/40">
          SHA-256 AUDITABLE
        </div>
        <p class="mt-1.5 text-[0.68rem] text-muted leading-tight">Audio recortado y texto archivados por coincidencia.</p>
      </div>
    </div>

    <!-- 2. Consola de Detección e Inspección de Testigos Forenses (Abierta y Limpia) -->
    <div class="mb-3">
      <SignalWitnessInspector client:visible />
    </div>

    <!-- 3. Botón de Acción Principal -->
    <div class="flex items-center justify-start">
      <Button href="/monitoreo-de-medios" variant="primary">
        <span>Ver MAYIA Escucha en detalle</span>
        <span class="flex size-5 items-center justify-center rounded-full bg-accent text-bg shadow-sm transition-transform duration-300 group-hover:translate-x-0.5">
          <Icon name="arrow-right" size={12} class="-rotate-45" />
        </span>
      </Button>
    </div>
  </div>
</section>
