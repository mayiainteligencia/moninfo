---
import { divisions } from '@/content/home';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
---
<section id="divisiones" aria-labelledby="divisiones-title" class="relative py-2 sm:py-4 w-full">
  <div class="container-x">
    <header class="mb-4 sm:mb-6 max-w-3xl">
      <div class="flex items-center gap-2 mb-2">
        <div class="h-1 w-8 rounded-full bg-accent shadow-[0_0_10px_rgba(34,197,94,0.7)]"></div>
        <p class="font-mono text-[0.65rem] sm:text-xs uppercase tracking-widest text-accent font-semibold">DIVISIONES EDGENET</p>
      </div>
      <h2 id="divisiones-title" class="text-2xl font-bold tracking-tight text-white sm:text-3xl md:text-4xl leading-[1.1]">
        Infraestructura y seguridad soberana.
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-muted/90 max-w-2xl leading-relaxed">
        MAYIA y FLAI operan servicios de seguridad, red, centro de datos, nube y desarrollo con IA bajo un mismo ecosistema soberano en México.
      </p>
    </header>

    <div class="grid gap-2.5 sm:gap-3 md:grid-cols-2 lg:grid-cols-3">
      {divisions.map((d) => (
        <Card tilt class="h-full !p-3.5 sm:!p-4 border-line-strong/60 bg-surface-2/60 hover:border-accent/60">
          <div class="mb-2.5 flex items-start justify-between">
            <span class="flex size-9 items-center justify-center rounded-lg border border-line bg-surface-3 text-accent shadow-sm">
              <Icon name={d.icon} size={18} />
            </span>
            <Badge status={d.status} />
          </div>
          <h3 class="text-base sm:text-lg font-semibold text-white">{d.title}</h3>
          <p class="mt-1.5 text-xs text-muted leading-relaxed line-clamp-3">{d.description}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
