---
import { divisions } from '@/content/home';
import Section from '@/components/ui/Section.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import Reveal from '@/components/motion/Reveal.astro';
---
<Section id="divisiones" eyebrow="Divisiones" title="Infraestructura, seguridad e inteligencia artificial bajo un mismo techo."
  lead="MAYIA y FLAI operan servicios de seguridad, red, centro de datos, nube y desarrollo con IA. El monitoreo de medios es la división que escucha lo que se transmite.">
  <Reveal class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" stagger>
    {divisions.map((d) => (
      <Card tilt class="h-full">
        <div class="mb-6 flex items-start justify-between">
          <span class="flex size-11 items-center justify-center rounded-md hairline bg-surface-3 text-accent"><Icon name={d.icon} size={22} /></span>
          <Badge status={d.status} />
        </div>
        <h3 class="text-xl font-semibold">{d.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">{d.description}</p>
      </Card>
    ))}
  </Reveal>
</Section>
