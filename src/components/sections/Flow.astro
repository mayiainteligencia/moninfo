---
import { flow, flowIntro } from '@/content/home';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import Reveal from '@/components/motion/Reveal.astro';
interface Props { id?: string }
const { id = 'flujo' } = Astro.props;
---
<Section id={id} eyebrow={flowIntro.eyebrow} title={flowIntro.title} lead={flowIntro.lead}>
  <div data-timeline class="relative [--p:1]">
    <div class="absolute bottom-0 left-5 top-0 w-px bg-line md:bottom-auto md:left-0 md:right-0 md:top-5 md:h-px md:w-auto" aria-hidden="true">
      <div class="h-full w-full origin-top bg-[image:var(--gradient-brand)] [transform:scaleY(var(--p))] md:origin-left md:[transform:scaleX(var(--p))]"></div>
    </div>
    <Reveal as="ol" class="grid gap-10 md:grid-cols-4 md:gap-6" stagger>
      {flow.map((s, i) => (
        <li data-step class="group relative pl-14 md:pl-0 md:pt-14 [&.is-active_.dot]:border-accent [&.is-active_.dot]:text-accent [&.is-active_.dot]:shadow-glow">
          <span class="dot absolute left-0 top-0 flex size-10 items-center justify-center rounded-full border border-line-strong bg-bg text-muted transition-all duration-500">
            <Icon name={s.icon} size={18} />
          </span>
          <p class="font-mono text-xs text-subtle">0{i + 1}</p>
          <h3 class="mt-1 text-2xl font-semibold">{s.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </Reveal>
  </div>
</Section>
